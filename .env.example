APP_DOMAIN=game.example.com
APP_PORT=4317
ACCESS_PASSWORD=replace-with-a-private-invitation-password
POSTGRES_DB=ravens_night
POSTGRES_USER=ravens
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://ravens:replace-with-a-long-random-password@postgres:5432/ravens_night
SESSION_SECRET=replace-with-at-least-32-random-bytes
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-long-random-password
# Empty rooms are removed after 2 hours; rooms with a started or finished game after 24 hours.
ROOM_LOBBY_TTL_MS=7200000
ROOM_ACTIVE_TTL_MS=86400000
